{
  "name": "closedoor-desktop",
  "productName": "Closedoor",
  "version": "0.1.0",
  "private": true,
  "description": "App de escritorio de Closedoor: la misma web, con las canciones completas del perfil (servidor de música local en 127.0.0.1)",
  "homepage": "https://app.foranly.space",
  "author": "Foranly",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "FORANLY_WEB_URL=http://localhost:5173 electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "space.foranly.desktop",
    "productName": "Closedoor",
    "executableName": "Closedoor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "app-package.json",
        "to": "app/package.json"
      },
      {
        "from": "../scripts/music-api-server.mjs",
        "to": "app/scripts/music-api-server.mjs"
      },
      {
        "from": "../api",
        "to": "app/api",
        "filter": [
          "**/*.js"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Closedoor",
      "artifactName": "Foranly-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "icon": "assets/icon.png",
      "artifactName": "Foranly-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "Foranly <dev@foranly.space>",
      "icon": "assets/icon.png",
      "artifactName": "Foranly-${version}-${arch}.${ext}"
    }
  }
}
