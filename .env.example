# Supabase Configuration
# Get these values from https://app.supabase.com

# Use the project URL (not the Data API URL) for supabase-js
VITE_SUPABASE_URL=https://<TU_PROYECTO>.supabase.co

# If you only have the Data API URL, this client will derive the project URL from it.
# VITE_SUPABASE_DATA_API_URL=https://<TU_PROYECTO>.supabase.co/data/v1

# For frontend use the publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=<TU_PUBLISHABLE_KEY>
# or the old public key environment variable name for backwards compatibility
# VITE_SUPABASE_PUBLIC_KEY=<TU_PUBLISHABLE_KEY>

# If you still have a legacy anon key, you can use it instead
VITE_SUPABASE_ANON_KEY=<TU_ANON_KEY>

VITE_KLIPY_API_KEY=<TU_KLIPY_API_KEY>
LIVEKIT_URL=wss://<TU_PROYECTO>.livekit.cloud
LIVEKIT_API_KEY=<TU_LIVEKIT_API_KEY>
LIVEKIT_API_SECRET=<TU_LIVEKIT_API_SECRET>
# --- Cloudflare Turnstile (CAPTCHA para login/registro) ---
# Site key (publica) para el frontend - dash.cloudflare.com -> Turnstile
# El SECRET key va en Supabase: Authentication > Security > Bot and Abuse Protection
VITE_TURNSTILE_SITE_KEY=<TU_TURNSTILE_SITE_KEY>
# --- Música (opcional) ---
# VITE_MUSIC_API_URL: SOLO para desarrollo, apuntando a un túnel (ngrok/cloudflared)
# que sirva el music server con HTTPS. En Vercel NO definirla: search/health usan
# el rewrite same-origin /api/music (ver vercel.json).
#
# VITE_MUSIC_STREAM_URL: URL HTTPS fija del music server para streaming completo.
# NO la definas en Vercel: el server ahora crea SU PROPIO túnel HTTPS automático
# (cloudflared, sin root) y expone la URL en /health → la app la detecta sola.
# Solo úsala si quieres forzar una URL concreta (p. ej. music.foranly.space).
# IMPORTANTE: debe ser https:// — el navegador bloquea audio HTTP desde una
# página HTTPS (Mixed Content). Vacía = usar el túnel automático / preview.
VITE_MUSIC_STREAM_URL=
#
# VITE_MUSIC_STREAM_VIA_VERCEL: si está en '1', el fallback de producción usa la
# función serverless api/music/stream.js (streaming real por HTTPS same-origin)
# en vez del rewrite /api/music/download (archivo completo). OJO: en Hobby el
# tope maxDuration puede cortar streams lentos (throttling de googlevideo); por
# defecto (vacío) se usa el túnel automático, que no tiene tope.
# VITE_MUSIC_STREAM_VIA_VERCEL=1
#
# ── Env vars del MUSIC SERVER (music-server/music-server.js, no Vite) ──
# El auto-setup descarga cloudflared (como yt-dlp/ffmpeg) y abre un túnel
# https://xxx.trycloudflare.com en background, registrado en .tunnel-url.txt.
# CLOUDFLARED_URL=https://music.foranly.space   → URL estable (túnel con nombre,
#   apunta al DNS por CNAME). Si está definida, no se descarga/lanza cloudflared.
# CLOUDFLARED_DISABLE=1                          → desactiva el túnel automático
#   (la app cae al preview de 30s por los rewrites de Vercel).
