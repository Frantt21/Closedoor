# Supabase Configuration
# Get these values from https://app.supabase.com

# Use the project URL (not the Data API URL) for supabase-js
VITE_SUPABASE_URL=https://<TU_PROYECTO>.supabase.co

# If you only have the Data API URL, this client will derive the project URL from it.
# VITE_SUPABASE_DATA_API_URL=https://<TU_PROYECTO>.supabase.co/data/v1

# For frontend use the publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=<TU_PUBLISHABLE_KEY>
# or the old public key environment variable name for backwards compatibility
# VITE_SUPABASE_PUBLIC_KEY=<TU_PUBLISHABLE_KEY>

# If you still have a legacy anon key, you can use it instead
VITE_SUPABASE_ANON_KEY=<TU_ANON_KEY>

VITE_KLIPY_API_KEY=<TU_KLIPY_API_KEY>
LIVEKIT_URL=wss://<TU_PROYECTO>.livekit.cloud
LIVEKIT_API_KEY=<TU_LIVEKIT_API_KEY>
LIVEKIT_API_SECRET=<TU_LIVEKIT_API_SECRET>
# --- Cloudflare Turnstile (CAPTCHA para login/registro) ---
# Site key (publica) para el frontend - dash.cloudflare.com -> Turnstile
# El SECRET key va en Supabase: Authentication > Security > Bot and Abuse Protection
VITE_TURNSTILE_SITE_KEY=<TU_TURNSTILE_SITE_KEY>
# Music streaming: connection directa al music server (Vercel rewrites no soportan streaming)
VITE_MUSIC_STREAM_URL=http://mapi.foranly.space:24633/api/music
