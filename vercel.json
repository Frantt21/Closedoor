{
  "functions": {
    "api/og-profile.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/profile/:username",
      "destination": "/api/og-profile"
    },
    {
      "source": "/cdn/(.*)",
      "destination": "http://api.foranly.space:24587/cdn/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
