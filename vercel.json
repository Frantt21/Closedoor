{
  "functions": {
    "api/og-profile.js": {
      "maxDuration": 10
    },
    "api/og-post.js": {
      "maxDuration": 10
    },
    "api/sitemap.xml.js": {
      "maxDuration": 15
    },
    "api/music/stream.js": {
      "maxDuration": 60
    },
    "api/music/resolve.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/profile/:username",
      "destination": "/api/og-profile"
    },
    {
      "source": "/post/:id",
      "destination": "/api/og-post"
    },
    {
      "source": "/api/image-proxy",
      "destination": "http://mapi.foranly.space:24633/api/image-proxy"
    },
    {
      "source": "/api/music/(.*)",
      "destination": "http://mapi.foranly.space:24633/api/music/$1"
    },
    {
      "source": "/cdn/(.*)",
      "destination": "http://api.foranly.space:24587/cdn/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
